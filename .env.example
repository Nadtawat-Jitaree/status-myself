# ─── Supabase Configuration ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# ใช้สำหรับ Stripe Webhook ในการอัปเดต role & วันหมดอายุข้าม RLS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# ─── Stripe Payment Configuration ──────────────────────────────
# Stripe API Keys (ได้จาก Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_51UYljXHxYFgQtAKnf4vMkK3QouGMWyu8YW7v0WilmQ7qtCe2bomt1rDPZoNzKwp71Yo5eixG0Cd8yie05s34pCjS00Dlf6RrKu
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret (ได้จาก Stripe Dashboard > Webhooks หรือ stripe listen)
STRIPE_WEBHOOK_SECRET=whsec_...

# (Optional) Stripe Price IDs หากสร้าง Price ใน Stripe Dashboard
# หากไม่ระบุ ระบบจะใช้ Dynamic Price 50 บาท/เดือน และ 500 บาท/ปี อัตโนมัติ
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ─── App URL ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
